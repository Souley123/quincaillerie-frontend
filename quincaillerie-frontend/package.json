{
  "homepage": "https://souley123.github.io/quincaillerie-frontend",
  "name": "quincaillerie-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "@zxing/browser": "^0.2.1",
    "axios": "^1.20.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "node scripts/demarrer-local.mjs",
    "start:frontend": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:production": "vite build",
    "test": "vitest run",
    "verif:acces": "node scripts/lancer-verif.mjs acces",
    "verif:tableaux": "node scripts/lancer-verif.mjs tableaux",
    "test:reinitialisation": "vitest run src/services/reinitialisationUrl.test.js",
    "deploy": "git subtree push --prefix dist origin gh-pages",
    "cap:sync": "node scripts/build-mobile.mjs",    "cap:android": "node scripts/build-mobile.mjs android && npx cap open android",
    "cap:ios": "node scripts/build-mobile.mjs ios && npx cap open ios",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.3",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^30.1.3",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  }
}
