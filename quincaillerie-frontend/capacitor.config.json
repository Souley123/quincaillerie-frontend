{
  "appId": "com.skys.erpsolution",
  "appName": "SKYS ERP Solution",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "allowNavigation": [
      "gestion-de-stocks-5lv3.onrender.com",
      "souley123.github.io",
      "*.kkiapay.me",
      "kkiapay.me",
      "*.skyserp.com"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "allowCleartext": false
  },
  "ios": {
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": false,
    "infoPlist": {
      "NSCameraUsageDescription": "La caméra est utilisée pour scanner les codes-barres et, si vous activez la surveillance, pour afficher le flux vidéo.",
      "NSMicrophoneUsageDescription": "L’application n’enregistre pas le son; le microphone est désactivé pour les fonctions caméra."
    }
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    }
  }
}