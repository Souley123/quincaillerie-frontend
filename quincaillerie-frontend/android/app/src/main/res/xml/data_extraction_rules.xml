<?xml version="1.0" encoding="utf-8"?>
<!--
  Sauvegarde complète : désactivée pour les données métier (ERP).
  Ce fichier est utilisé par Android 12+ (API 31+) via android:dataExtractionRules.
  Tout est exclu : jetons d'authentification, cache du WebView, données de caisse.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Aucun export vers Google Drive / sauvegarde cloud. -->
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="cache" />
    </cloud-backup>
    <device-transfer>
        <!-- Aucun transfert vers un nouvel appareil. -->
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="cache" />
    </device-transfer>
</data-extraction-rules>
