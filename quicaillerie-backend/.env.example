PORT=5001
MONGODB_URI=mongodb+srv://UTILISATEUR:MOT_DE_PASSE@cluster.mongodb.net/Quincaillerie_db

# =============================================
# AUTHENTIFICATION MULTI-TENANT (OBLIGATOIRE)
# =============================================
# Secret de signature des jetons de session.
# Générez-le avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Ne le changez JAMAIS en production : cela invalide toutes les sessions.
JWT_SECRET=
# Durée de validité d'une session (12h, 7d, 30d...)
JWT_DUREE=12h
# URL HTTPS publique du frontend pour les liens de réinitialisation
APP_URL=https://votre-domaine.com
# Une valeur par origine, séparées par des virgules.
# En production le serveur refuse de démarrer si cette liste est vide.
CORS_ORIGINS=https://souley123.github.io,http://localhost:3000,http://127.0.0.1:3000

# Taille maximale du corps JSON reçu (ex. 1mb, 512kb)
JSON_LIMIT=1mb

# Email administrateur (SMTP) - expediteur des alertes et des emails de reinitialisation
# Exemple Gmail : SMTP_PASSWORD doit etre un MOT DE PASSE D'APPLICATION Google
# (16 caracteres, sans espaces) et non le mot de passe du compte.
# Creer sur : https://myaccount.google.com/apppasswords (2FA requise).
# Le mot de passe d'application n'est valable que pour LE compte qui l'a genere.
# Port 465 = TLS implicite (SMTP_SECURE=true) ; port 587 = STARTTLS (SMTP_SECURE=false).
ADMIN_EMAIL=supportskys@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=supportskys@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM=SKYS ERP Solution <supportskys@gmail.com>

# WhatsApp Cloud API Meta (optionnel)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
ADMIN_WHATSAPP=

# =============================================
# PAIEMENTS EN LIGNE (KKIAPAY) — OBLIGATOIRE POUR VÉRIFIER LES PAIEMENTS
# =============================================
# La clé PUBLIQUE peut être exposée au frontend (elle ouvre le widget).
KKIAPAY_PUBLIC=
# La clé PRIVÉE et la clé SECRÈTE ne quittent JAMAIS le serveur.
# Sans elles, /api/paiements/verifier refuse toute validation :
# mieux vaut refuser une vente que d'enregistrer un paiement non prouvé.
KKIAPAY_PRIVATE=
KKIAPAY_SECRET=
# URL de base de l'API Kkiapay (ne changez pas sauf consigne du prestataire).
KKIAPAY_BASE_URL=https://api.kkiapay.me

# Version applicative exposée par le point de santé (GET /).
APP_VERSION=1.0.0

# =============================================
# COMPTE DE DÉMONSTRATION / TEST (3 JOURS)
# =============================================
# Mettre DEMO_COMPTE=actif pour provisionner au démarrage un compte de test
# prêt à l'emploi. À l'échéance (3 jours par défaut), l'accès est coupé
# automatiquement par le middleware multi-tenant : aucune action manuelle.
# NE PAS activer en production réelle (il s'agit d'un accès délibéré).
DEMO_COMPTE=inactif
DEMO_EMAIL=demo@skys-erp.com
DEMO_MOT_DE_PASSE=Skys-Demo-2026!
DEMO_SLUG=demo
DEMO_DUREE_JOURS=3

# Durée de l'essai gratuit accordé aux nouvelles inscriptions (en jours).
ESSAI_JOURS=3
