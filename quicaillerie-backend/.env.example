PORT=5001
MONGODB_URI=mongodb+srv://UTILISATEUR:MOT_DE_PASSE@cluster.mongodb.net/Quincaillerie_db

# =============================================
# AUTHENTIFICATION MULTI-TENANT (OBLIGATOIRE)
# =============================================
# Secret de signature des jetons de session.
# Générez-le avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Ne le changez JAMAIS en production : cela invalide toutes les sessions.
JWT_SECRET=
# Durée de validité d'une session (12h, 7d, 30d...)
JWT_DUREE=12h

# Email administrateur (SMTP)
ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=SMTP_USER
SMTP_PASSWORD=SMTP_PASSWORD
SMTP_FROM=ERP Quincaillerie <no-reply@example.com>

# WhatsApp Cloud API Meta (optionnel)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
ADMIN_WHATSAPP=
